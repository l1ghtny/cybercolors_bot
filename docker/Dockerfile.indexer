FROM python:3.14-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.30 /uv /uvx /bin/
COPY --from=denoland/deno:bin-2.8.1 /deno /usr/local/bin/deno

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/home/discord-bot \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=1 \
    UV_PYTHON_DOWNLOADS=0 \
    DENO_NO_UPDATE_CHECK=1 \
    PATH="/home/discord-bot/.venv/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgcc-s1 \
    && rm -rf /var/lib/apt/lists/* \
    && deno --version

WORKDIR /home/discord-bot

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY src/__init__.py ./src/__init__.py
COPY src/db ./src/db
COPY src/modules/__init__.py ./src/modules/__init__.py
RUN mkdir -p ./src/modules/ai ./src/modules/observability ./scripts
COPY src/modules/ai ./src/modules/ai
COPY src/modules/observability ./src/modules/observability
COPY scripts/run_ai_knowledge_worker.py scripts/run_youtube_channel_worker.py ./scripts/

CMD ["python", "scripts/run_ai_knowledge_worker.py"]

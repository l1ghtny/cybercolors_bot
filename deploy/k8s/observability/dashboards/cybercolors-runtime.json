    {"id":7,"title":"CPU throttling by pod","type":"timeseries","gridPos":{"h":9,"w":12,"x":0,"y":14},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 * sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"cybercolors\",container!=\"\",image!=\"\"}[5m])) / clamp_min(sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=\"cybercolors\",container!=\"\",image!=\"\"}[5m])), 0.001)","legendFormat":"{{pod}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]}},
    {"id":8,"title":"Pod network throughput","type":"timeseries","gridPos":{"h":9,"w":12,"x":12,"y":14},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"topk(10, sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"cybercolors\"}[5m])))","legendFormat":"{{pod}} receive","refId":"A"},{"expr":"topk(10, sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"cybercolors\"}[5m])))","legendFormat":"{{pod}} transmit","refId":"B"}],"fieldConfig":{"defaults":{"unit":"Bps"},"overrides":[]}},

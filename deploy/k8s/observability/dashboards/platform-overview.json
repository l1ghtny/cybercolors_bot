  "graphTooltip":1,
  "panels":[
    {"id":1,"title":"Ready nodes","type":"stat","gridPos":{"h":5,"w":6,"x":0,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":4}]}},"overrides":[]}},
    {"id":2,"title":"Scrape success","type":"stat","gridPos":{"h":5,"w":6,"x":6,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 * sum(up) / count(up)","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"yellow","value":95},{"color":"green","value":99}]}},"overrides":[]}},
    {"id":3,"title":"Firing alerts (excluding Watchdog)","type":"stat","gridPos":{"h":5,"w":6,"x":12,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\"}) or vector(0)","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":3}]}},"overrides":[]}},
    {"id":4,"title":"Container restarts (1h)","type":"stat","gridPos":{"h":5,"w":6,"x":18,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(increase(kube_pod_container_status_restarts_total[1h]))","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":5}]}},"overrides":[]}},
    {"id":5,"title":"Cluster CPU used","type":"timeseries","gridPos":{"h":8,"w":12,"x":0,"y":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100","legendFormat":"CPU used","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]}},
    {"id":6,"title":"Cluster memory used","type":"timeseries","gridPos":{"h":8,"w":12,"x":12,"y":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 * (1 - sum(node_memory_MemAvailable_bytes) / sum(node_memory_MemTotal_bytes))","legendFormat":"Memory used","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]}},
    {"id":7,"title":"CPU by namespace","type":"timeseries","gridPos":{"h":9,"w":12,"x":0,"y":13},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"topk(10, sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\",image!=\"\"}[5m])))","legendFormat":"{{namespace}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"cores"},"overrides":[]}},
    {"id":8,"title":"Memory by namespace","type":"timeseries","gridPos":{"h":9,"w":12,"x":12,"y":13},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"topk(10, sum by (namespace) (container_memory_working_set_bytes{container!=\"\",image!=\"\"}))","legendFormat":"{{namespace}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"id":9,"title":"PVC utilization","type":"timeseries","gridPos":{"h":9,"w":12,"x":0,"y":22},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 * (1 - kubelet_volume_stats_available_bytes / kubelet_volume_stats_capacity_bytes)","legendFormat":"{{namespace}} / {{persistentvolumeclaim}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":75},{"color":"red","value":90}]}},"overrides":[]}},
    {"id":10,"title":"Target health by job","type":"timeseries","gridPos":{"h":9,"w":12,"x":12,"y":22},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 * sum by (job) (up) / count by (job) (up)","legendFormat":"{{job}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]}},
    {"id":11,"title":"Filesystem used by node","type":"timeseries","gridPos":{"h":9,"w":12,"x":0,"y":31},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/\"})","legendFormat":"{{instance}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]}},
    {"id":12,"title":"Top restart offenders (24h)","type":"timeseries","gridPos":{"h":9,"w":12,"x":12,"y":31},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"topk(10, sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[24h])))","legendFormat":"{{namespace}} / {{pod}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}}
  ],
  "refresh":"30s","schemaVersion":41,"tags":["observability","kubernetes","platform"],"templating":{"list":[]},"time":{"from":"now-6h","to":"now"},"timezone":"browser","title":"Platform Overview","uid":"platform-overview","version":1
